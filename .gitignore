# Godot 4 — cache de importação e metadados gerados
.godot/
*.translation

# Saída de exportação (APK/AAB e pacotes)
build/android/*.apk
build/android/*.aab
build/android/*.idsig
export_presets.cfg.bak

# Chaves de assinatura — NUNCA versionar
*.keystore
*.jks
!debug.keystore

# Sistema operacional / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Modelos de terceiros: baixados localmente, nunca versionados
assets/models/player/original/*
!assets/models/player/original/README.md

# Texturas extraídas automaticamente pelo importador do .glb (regeneradas no import)
assets/models/player/spiderman_newlife_*.png
assets/models/player/spiderman_newlife_*.png.import

# Memória do agente OpenHands (local, não faz parte do jogo)
.openhands/

# Cache do Python (ferramentas de build)
__pycache__/
*.pyc

# Metadados de importacao dos FBX do Mixamo (gerados no import)
assets/animations/mixamo/*.fbx.import
